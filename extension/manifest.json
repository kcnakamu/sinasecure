{
  "manifest_version": 3,
  "name": "SinaSecure",
  "version": "0.1.0",
  "description": "Detects deepfakes in TikTok videos.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*/video/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
